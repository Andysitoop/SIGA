{
    "name": "sistema-academico/sistema-academico",
    "description": "Sistema académico para gestión de alumnos, cursos y notas",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "bcosca/fatfree-core": "^3.8",
        "vlucas/phpdotenv": "^5.5",
        "fpdf/fpdf": "^1.86"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
